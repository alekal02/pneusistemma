# ============================================================
# BACKEND - Configuração da API
# ============================================================

PORT=3000
NODE_ENV=development
HOST=localhost

# Banco SQLite
DB_PATH=./data/pneus.db

# Limites de sulco (mm)
SULCO_MINIMO_MM=3.0
SULCO_ALERTA_MM=8.0

# URL do frontend (CORS) — deve bater com a porta do Vite em dev
CORS_ORIGIN=http://localhost:5173

# Autenticação
JWT_SECRET=altere-este-segredo-em-producao
JWT_EXPIRES_IN=7d
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# URL pública do frontend (links de acesso rápido via WhatsApp)
FRONTEND_URL=http://localhost:5173

# ============================================================
# WuzAPI (WhatsApp)
# ============================================================
WUZAPI_BASE_URL=http://localhost:8080
WUZAPI_TOKEN=TOKEN_DO_USUARIO_WUZAPI
WUZAPI_ADMIN_TOKEN=TOKEN_ADMIN_WUZAPI
# Opcional: HMAC do webhook (configurar em /session/hmac/config no WuzAPI)
WUZAPI_WEBHOOK_SECRET=
# Fallback se não houver usuário com cargo gerente_compras no banco
GERENTE_COMPRAS_WHATSAPP=5511999999999

# ============================================================
# PRODUÇÃO (Digital Ocean)
