# ============================================================
# BACKEND - Configuração da API
# ============================================================

PORT=3000
NODE_ENV=development
HOST=localhost

# Banco SQLite
DB_PATH=./data/pneus.db

# Limites de sulco (mm)
SULCO_MINIMO_MM=1.6
SULCO_ALERTA_MM=3.0

# URL do frontend (CORS) — deve bater com a porta do Vite em dev
CORS_ORIGIN=http://localhost:5173

