# ============================================================
# BACKEND - Configuração da API
# ============================================================

PORT=3000
NODE_ENV=development
# Em dev com WuzAPI no Docker, use 0.0.0.0 para o webhook chegar na API
HOST=0.0.0.0

# Banco SQLite
DB_PATH=./data/pneus.db

# Limites de sulco (mm)
SULCO_MINIMO_MM=3.0
SULCO_ALERTA_MM=8.0

# URL do frontend (CORS) — deve bater com a porta do Vite em dev
CORS_ORIGIN=http://localhost:5173

# Autenticação
JWT_SECRET=altere-este-segredo-em-producao
JWT_EXPIRES_IN=7d
ADMIN_USER=admin
ADMIN_PASSWORD=admin123

# URL pública do frontend (links de acesso rápido via WhatsApp)
# URL pública do frontend (links WhatsApp). Em LAN use o IP do PC, não localhost.
FRONTEND_URL=http://10.0.0.231:5173

# ============================================================
# WuzAPI (WhatsApp)
# ============================================================
WUZAPI_BASE_URL=http://localhost:8080
# Token de usuário WuzAPI (não use o admin aqui). No app: botão "Gerar token".
WUZAPI_TOKEN=
# Admin do WuzAPI — docker-compose.wuzapi.yml usa 1234ABCD
WUZAPI_ADMIN_TOKEN=1234ABCD
# URL do webhook vista pelo container WuzAPI (Docker Desktop Windows/Mac)
WUZAPI_WEBHOOK_PUBLIC_URL=http://host.docker.internal:3000/api/webhook/whatsapp
# Opcional: HMAC do webhook (configurar em /session/hmac/config no WuzAPI)
WUZAPI_WEBHOOK_SECRET=
# Fallback se não houver usuário com cargo gerente_compras no banco
GERENTE_COMPRAS_WHATSAPP=5511999999999

# ============================================================
# PRODUÇÃO (Digital Ocean)
# ============================================================
# HOST=0.0.0.0
# NODE_ENV=production
